# Verify the certification source before emitting the importable registry.
manifest := parse_json(read_file("providers/certification.json"))
if manifest["schema_version"] != 1 { print("Unsupported provider certification schema"); exit(1) }
seen := {}
for provider in manifest["providers"] {
    id := provider["id"]
    if has_key(seen, id) { print("Duplicate provider " + id); exit(1) }
    seen[id] = true
    evidence := {}
    for row in provider["live_evidence"] {
        if row["result"] == "passed" && row["date"] == provider["verification_date"] {
            evidence[row["capability"]] = true
        }
    }
    for capability in keys(provider["capabilities"]) {
        status := provider["capabilities"][capability]
        if status != "verified" && status != "experimental" && status != "unknown" && status != "unsupported" {
            print("Unknown capability status for " + id); exit(1)
        }
        if status == "verified" && has_key(evidence, capability) == 0 {
            print("Missing live evidence for " + id + "/" + capability); exit(1)
        }
    }
    if (provider["live_status"] == "verified" || provider["live_status"] == "partial") && len(keys(evidence)) == 0 {
        print("Missing live verification records for " + id); exit(1)
    }
}
source := "# Generated by scripts/generate_provider_registry.kujo.\nexport provider_records := func() {\n    return " + to_json(manifest["providers"]) + "\n}\n"
if args() == ["--check"] {
    if read_file("src/provider_registry_data.kujo") != source {
        print("Provider registry projection is stale")
        exit(1)
    }
} else {
    write_file("src/provider_registry_data.kujo", source, true)
}

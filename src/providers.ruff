export deepseek_provider := func() {
	return {
		"name": "deepseek",
		"base_url": "https://api.deepseek.com/v1",
		"chat_path": "/chat/completions",
		"api_key_env": "DEEPSEEK_API_KEY",
		"default_model": "deepseek-chat",
		"capabilities": {
			"streaming": true,
			"tool_calls": true,
			"json_mode": true,
			"embeddings": true
		}

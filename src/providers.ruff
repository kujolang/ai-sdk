export custom_openai_compatible_provider := func(base_url, api_key_env, default_model) {
	allow_insecure_localhost := bool_from_env_flag(env("KUJO_AI_SDK_ALLOW_INSECURE_LOCALHOST"))
	return custom_openai_compatible_provider_with_options_impl(base_url, api_key_env, default_model, allow_insecure_localhost)
}

export custom_openai_compatible_provider_with_options := custom_openai_compatible_provider_with_options_impl

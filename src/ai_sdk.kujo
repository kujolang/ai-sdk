export resolve_model_preference := resolve_model_preference_impl
export create_client := create_client_impl
export create_message := create_message_impl
export build_chat_payload := build_chat_payload_impl
export standard_error_response := standard_error_response_impl
export normalize_provider_error := normalize_provider_error_payload
export parse_json_contract := parse_json_safe
export parse_sse_contract := parse_sse_lines
export parse_sse_chunks_contract := parse_sse_chunks
export should_retry_error_result := should_retry_result
export retry_delay_contract := compute_retry_delay_ms
export sdk_contract_version := contract_version_value

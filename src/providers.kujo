# Provider presets for OpenAI-compatible chat APIs.

func bool_from_env_flag(value) {
	if value == "1" {
		return true
	}
	if value == "true" {
		return true
	}
	if value == "TRUE" {
		return true
	}
	return false
}

func validate_custom_provider_base_url(base_url, allow_insecure_localhost) {
	if type(base_url) != "string" {
		return {
			"ok": false,
			"error": "Invalid base_url: expected a string URL."
		}
	}

	trimmed_url := trim(base_url)
	if trimmed_url == "" {
		return {
			"ok": false,
			"error": "Invalid base_url: URL cannot be empty."
		}
	}

	if contains(trimmed_url, "@") {
		return {
			"ok": false,
			"error": "Invalid base_url: URL must not include embedded credentials."
		}
	}

	if contains(trimmed_url, "?") {
		return {
			"ok": false,
			"error": "Invalid base_url: query parameters are not allowed."
		}
	}

	if contains(trimmed_url, "#") {
		return {
			"ok": false,
			"error": "Invalid base_url: URL fragments are not allowed."
		}
	}

	lower_url := lower(trimmed_url)
	parts := split(trimmed_url, "/")
	if len(parts) < 3 || trim(parts[2]) == "" {
		return {
			"ok": false,
			"error": "Invalid base_url: URL must include a host."
		}
	}

	if starts_with(lower_url, "https://") {
		return {
			"ok": true,
			"error": ""
		}
	}

	authority := lower(trim(parts[2]))
	is_localhost_host := authority == "localhost" || starts_with(authority, "localhost:")
	is_loopback_host := authority == "127.0.0.1" || starts_with(authority, "127.0.0.1:")
	is_localhost_http := starts_with(lower_url, "http://") && (is_localhost_host || is_loopback_host)
	if is_localhost_http {
		if allow_insecure_localhost {
			return {
				"ok": true,
				"error": ""
			}
		}
		return {
			"ok": false,
			"error": "Invalid base_url: insecure localhost HTTP requires explicit opt-in."
		}
	}

	return {
		"ok": false,
		"error": "Invalid base_url: only https:// endpoints are allowed by default."
	}
}

func custom_openai_compatible_provider_with_options_impl(base_url, api_key_env, default_model, allow_insecure_localhost) {
	validation := validate_custom_provider_base_url(base_url, allow_insecure_localhost)
	normalized_base_url := base_url
	if type(normalized_base_url) == "string" {
		normalized_base_url := trim(normalized_base_url)
		while ends_with(normalized_base_url, "/") {
			normalized_base_url := substring(normalized_base_url, 0, len(normalized_base_url) - 1)
		}
	}

	provider := {
		"name": "openai-compatible",
		"base_url": normalized_base_url,
		"chat_path": "/chat/completions",
		"api_key_env": api_key_env,
		"default_model": default_model,
		"supported_models": [default_model],
		"models": [{
			"model": default_model,
			"quality_tier": "unknown",
			"source": "custom_provider"
		}],
		"model_preferences": {
			"frontier_reasoning": default_model,
			"adversarial_reasoning": default_model,
			"implementation_reasoning": default_model,
			"systems_reasoning": default_model,
			"strategic_reasoning": default_model
		},
		"capabilities": {
			"streaming": true,
			"tool_calls": true,
			"json_mode": true,
			"embeddings": true
		}
	}

	if !validation["ok"] {
		provider["validation_error"] := validation["error"]
	} else {
		provider["validation_error"] := ""
	}

	return provider
}

export openai_provider := func() {
	return {
		"name": "openai",
		"base_url": "https://api.openai.com/v1",
		"chat_path": "/chat/completions",
		"api_key_env": "OPENAI_API_KEY",
		"default_model": "gpt-4.1-mini",
		"supported_models": ["gpt-4.1-mini"],
		"models": [{
			"model": "gpt-4.1-mini",
			"quality_tier": "unknown",
			"source": "openai_provider_preset"
		}],
		"model_preferences": {
			"frontier_reasoning": "gpt-4.1-mini",
			"adversarial_reasoning": "gpt-4.1-mini",
			"implementation_reasoning": "gpt-4.1-mini",
			"systems_reasoning": "gpt-4.1-mini",
			"strategic_reasoning": "gpt-4.1-mini"
		},
		"capabilities": {
			"streaming": true,
			"tool_calls": true,
			"json_mode": true,
			"embeddings": true
		}
	}
}


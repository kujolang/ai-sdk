from provider_registry_data import provider_records
from providers import custom_openai_compatible_provider_with_options
from provider_driver import resolve_provider_driver

func get(record, key, fallback) {
    if type(record) == "dict" && has_key(record, key) { return record[key] }
    return fallback
}

export list_providers := provider_records

export func inspect_provider(id) {
    for record in provider_records() {
        if record["id"] == id { return record }
    }
    return null
}

export func require_provider_capabilities(provider, required) {
    capabilities := get(provider, "capabilities", {})
    missing := []
    for capability in required {
        if !get(capabilities, capability, false) { missing = push(missing, capability) }
    }
    return {"ok": len(missing) == 0, "missing": missing}
}

func setup_error(record, message) {
    return {"ok": false, "error": message, "setup": record["setup"]}
}

func valid_network_base(base_url) {
    # An ordinary DNS or IPv4 authority keeps the URL interpretation consistent
    # with the SDK's same-origin check. The runtime governs resolved addresses.
    pattern := "^https?://[A-Za-z0-9]([A-Za-z0-9.-]*[A-Za-z0-9])?(:[0-9]{1,5})?(/[A-Za-z0-9_.~-]+)*/?$"
    return type(base_url) == "string" && len(base_url) <= 2048 && regex_match(base_url, pattern)
}

func configure_package(record, model, options) {
    setup := record["setup"]
    factory := get(options, "package_factory", null)
    if type(factory) != "function" {
        return setup_error(record, "Install " + setup["source"] + " and pass " + setup["factory"] + " from " + setup["module"] + " as package_factory.")
    }
    package_options := get(options, "package_options", {})
    if type(package_options) != "dict" { return setup_error(record, "package_options must be a dictionary.") }
    package_options[setup["model_field"]] = model

    value := null
    try { value = factory(package_options) } except err { value = null }
    if type(value) != "dict" || len(keys(value)) == 0 || get(value, "validation_error", "") != "" {
        return setup_error(record, "Package configuration failed. Check the provider setup guide and required options.")
    }
    if setup["mode"] == "native_client" {
        for field in setup["client_fields"] {
            if has_key(value, field) == 0 {
                return setup_error(record, "The package factory did not return the expected native client.")
            }
        }
        return {"ok": true, "kind": "native", "client": value, "model": model, "record": record}
    }

    driver := get(value, "driver", {})
    if get(driver, "id", "") != setup["driver_id"] {
        return setup_error(record, "The package factory did not return the expected provider driver.")
    }
    capabilities := get(value, "capabilities", {})
    if type(capabilities) != "dict" { return setup_error(record, "The package driver must declare its capabilities.") }
    capabilities["chat"] = true
    # Some released packages advertise native capabilities that their SDK driver
    # cannot dispatch. Expose only the operations with matching SDK hooks.
    capabilities["streaming"] = get(capabilities, "streaming", false) && type(get(driver, "decode_stream", null)) == "function"
    capabilities["embeddings"] = get(capabilities, "embeddings", false) &&
        type(get(driver, "encode_embeddings", null)) == "function" && type(get(driver, "decode_embeddings", null)) == "function"
    value["capabilities"] = capabilities
    value["name"] = record["id"]
    value["package_provider"] = true
    if get(value, "default_model", "") != model || type(get(value, "api_key_env", "")) != "string" {
        return setup_error(record, "The package factory did not apply the selected model or credential configuration.")
    }
    allow_local := get(value, "allow_insecure_localhost", false)
    base_url := get(value, "base_url", "")
    if !valid_network_base(base_url) { return setup_error(record, "Invalid package provider endpoint URL.") }
    endpoint := custom_openai_compatible_provider_with_options(base_url, "", model, allow_local)
    if endpoint["validation_error"] != "" {
        return setup_error(record, "Package provider endpoint is invalid. Use HTTPS or supported loopback HTTP.")
    }
    resolution := resolve_provider_driver(value)
    if !resolution["ok"] { return setup_error(record, "The package driver does not meet the AI SDK provider contract.") }
    return {"ok": true, "kind": "sdk", "provider": value, "model": model, "record": record}
}

# Package factories are explicit trusted dependencies. The registry does not
# fetch code, load a package from a string, or select a substitute provider.
export func configure_provider(id, model, options) {
    record := inspect_provider(id)
    if record == null { return {"ok": false, "error": "Unknown SDK provider ID."} }
    if type(model) != "string" || len(trim(model)) == 0 || len(model) > 512 {
        return setup_error(record, "Set an explicit provider model identifier.")
    }
    if type(options) != "dict" { return setup_error(record, "Provider options must be a dictionary.") }
    if record["setup"]["mode"] != "sdk_preset" { return configure_package(record, model, options) }

    local := record["category"] == "Local"
    base_url := get(options, "base_url", record["base_url"])
    if !local && base_url != record["base_url"] {
        return {"ok": false, "error": "Hosted preset credentials are scoped to the official endpoint."}
    }
    if !valid_network_base(base_url) {
        return {"ok": false, "error": "Invalid provider URL. Use HTTPS or loopback HTTP for a local preset."}
    }
    key_env := record["api_key_env"]
    # A self-hosted override must explicitly select its own credential source.
    if local && base_url != record["base_url"] { key_env = "" }
    key_env = get(options, "api_key_env", key_env)
    if type(key_env) != "string" { return {"ok": false, "error": "api_key_env must be a string."} }
    provider := custom_openai_compatible_provider_with_options(base_url, key_env, model, local)
    if provider["validation_error"] != "" { return {"ok": false, "error": provider["validation_error"]} }

    enabled := get(options, "enable_capabilities", [])
    if type(enabled) != "array" { return {"ok": false, "error": "enable_capabilities must be an array."} }
    capabilities := {}
    for name in ["chat", "streaming", "model_discovery", "model_management", "reranking", "reader", "audio_generation"] {
        status := record["capabilities"][name]
        capabilities[name] = status == "verified" || status == "experimental"
    }
    if id == "voyage" || id == "jina" { capabilities["embeddings"] = true }
    for name in enabled {
        status := get(record["capabilities"], name, "unknown")
        if status != "verified" && status != "experimental" {
            return {"ok": false, "error": "Requested capability has no implementation for this provider."}
        }
        capabilities[name] = true
    }

    provider["name"] = id
    provider["capabilities"] = capabilities
    provider["allow_anonymous"] = local
    provider["registered_provider"] = true
    provider["stream_usage"] = get(options, "stream_usage", false)
    if type(provider["stream_usage"]) != "bool" { return {"ok": false, "error": "stream_usage must be boolean."} }
    provider["models"] = [{"model": model, "quality_tier": "unknown", "source": "configured_provider"}]
    return {"ok": true, "kind": "sdk", "provider": provider, "model": model, "record": record}
}

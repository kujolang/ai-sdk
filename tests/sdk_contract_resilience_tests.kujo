test "retry_budget caps retries below max_retries" {
	provider := openai_provider()
	client := create_client(provider, "fixture-key")
	messages := [create_message("user", "retry ceiling")]
	state := {
		"calls": 0
	}

	transport_fails := func(url, request_options) {
		state["calls"] := state["calls"] + 1
		return Err("transient timeout")
	}

	result := chat_completion(client, messages, {
		"transport": transport_fails,
		"max_retries": 5,
		"retry_budget": 1,
		"retry_delay_ms": 1
	})

	assert_false(result["ok"])
	assert_equal(result["error"]["code"], "network_error")
	assert_equal(result["observability"]["retry_count"], 1)
	assert_equal(result["observability"]["start_count"], 2)
}

test "retry jitter contributes deterministic delay value" {
	delay_no_jitter := retry_delay_contract(0, 10, 5000, 0)
	delay_with_jitter := retry_delay_contract(0, 10, 5000, 11)
	delay_capped := retry_delay_contract(3, 800, 1000, 500)

	assert_equal(delay_no_jitter, 10)
	assert_equal(delay_with_jitter, 11)
	assert_equal(delay_capped, 1000)
}

test "circuit breaker opens after consecutive retryable failures" {
	provider := openai_provider()
	client := create_client(provider, "fixture-key")
	messages := [create_message("user", "breaker")]

	always_retryable_fail := func(url, request_options) {
		return Err("timeout")
	}

	result := chat_completion(client, messages, {
		"transport": always_retryable_fail,
		"max_retries": 5,
		"circuit_breaker_enabled": true,
		"circuit_breaker_error_threshold": 2,
		"circuit_breaker_cooldown_ms": 5000
	})
	assert_false(result["ok"])
	assert_equal(result["error"]["code"], "circuit_breaker_open")
	assert_equal(result["observability"]["start_count"], 2)
	assert_equal(result["observability"]["complete_count"], 2)
	assert_equal(result["observability"]["retry_count"], 1)
}

test "overall deadline short-circuits request execution" {
	provider := openai_provider()
	client := create_client(provider, "fixture-key")
	messages := [create_message("user", "deadline")]

	transport_should_not_run := func(url, request_options) {
		return Ok({
			"_status": 200,
			"_body": "{\"choices\":[{\"message\":{\"content\":\"late\"}}]}"
		})
	}

	result := chat_completion(client, messages, {
		"transport": transport_should_not_run,
		"max_retries": 3,
		"deadline_ms": 1
	})

	assert_false(result["ok"])
	assert_equal(result["error"]["code"], "deadline_exceeded")
	assert_equal(result["status_code"], 408)
}

test "half-open circuit breaker allows probe then re-opens on failure" {
	provider := openai_provider()
	client := create_client(provider, "fixture-key")
	messages := [create_message("user", "half-open probe")]
	client["circuit_breaker_open_until_ms"] := current_timestamp() + 10000

	blocked_result := chat_completion(client, messages, {
		"transport": func(url, request_options) {
			return Ok({
				"_status": 200,
				"_body": "{\"id\":\"unexpected\",\"model\":\"gpt-4.1-mini\",\"choices\":[{\"message\":{\"content\":\"ok\"},\"finish_reason\":\"stop\"}],\"usage\":{\"prompt_tokens\":1,\"completion_tokens\":1,\"total_tokens\":2}}"
			})
		},
		"circuit_breaker_enabled": true,
		"circuit_breaker_error_threshold": 2,
		"circuit_breaker_cooldown_ms": 5000
	})
	assert_false(blocked_result["ok"])
	assert_equal(blocked_result["error"]["code"], "circuit_breaker_open")

	client["circuit_breaker_open_until_ms"] := current_timestamp() - 1
	probe_result := chat_completion(client, messages, {
		"transport": func(url, request_options) {
			return Err("probe timeout")
		},
		"max_retries": 5,
		"circuit_breaker_enabled": true,
		"circuit_breaker_error_threshold": 2,
		"circuit_breaker_cooldown_ms": 5000,
		"circuit_breaker_half_open_enabled": true,
		"circuit_breaker_half_open_max_retries": 0
	})
	assert_false(probe_result["ok"])
	assert_equal(probe_result["error"]["code"], "circuit_breaker_open")
	assert_equal(probe_result["observability"]["start_count"], 1)
	assert_equal(probe_result["observability"]["complete_count"], 1)
	assert_equal(probe_result["observability"]["retry_count"], 0)
}

test "state backend enables shared breaker state across clients" {
	provider := openai_provider()
	client_b := create_client(provider, "fixture-key")
	messages := [create_message("user", "shared breaker")]
	backend := {
		"state": {
			"ai_sdk:shared-breaker:breaker_consecutive_failures": 1,
			"ai_sdk:shared-breaker:breaker_open_until_ms": 0
		}
	}

	always_timeout := func(url, request_options) {
		return Err("timeout")
	}

	second_result := chat_completion(client_b, messages, {
		"transport": always_timeout,
		"max_retries": 0,
		"state_backend": backend,
		"state_namespace": "shared-breaker",
		"circuit_breaker_enabled": true,
		"circuit_breaker_error_threshold": 2,
		"circuit_breaker_cooldown_ms": 5000
	})
	assert_false(second_result["ok"])
	assert_equal(second_result["error"]["code"], "circuit_breaker_open")
}

test "request prompt budget fails fast before transport" {
	provider := openai_provider()
	client := create_client(provider, "fixture-key")
	messages := [create_message("user", "0123456789")]

	transport_should_not_run := func(url, request_options) {
		return Ok({
			"_status": 200,
			"_body": "{\"id\":\"unexpected\",\"choices\":[]}" 
		})
	}

	result := chat_completion(client, messages, {
		"transport": transport_should_not_run,
		"max_prompt_characters": 5,
		"max_retries": 0
	})

	assert_false(result["ok"])
	assert_equal(result["error"]["code"], "request_budget_exceeded")
}

test "request tool budget fails when tools exceed configured ceiling" {
	provider := openai_provider()
	client := create_client(provider, "fixture-key")
	messages := [create_message("user", "tool budget")]

	tools := [
		{"type": "function", "function": {"name": "t1"}},
		{"type": "function", "function": {"name": "t2"}}
	]

	result := chat_completion(client, messages, {
		"offline_fixture": false,
		"max_tools_per_request": 1,
		"tools": tools,
		"transport": func(url, request_options) {
			return Ok({"_status": 200, "_body": "{}"})
		},
		"max_retries": 0
	})

	assert_false(result["ok"])
	assert_equal(result["error"]["code"], "request_budget_exceeded")
}

test "max_in_flight_requests blocks calls when client slot is saturated" {
	provider := openai_provider()
	client := create_client(provider, "fixture-key")
	client["in_flight_requests"] := 1
	messages := [create_message("user", "concurrency")]

	result := chat_completion(client, messages, {
		"max_in_flight_requests": 1,
		"max_retries": 0,
		"transport": func(url, request_options) {
			return Ok({
				"_status": 200,
				"_body": "{\"id\":\"x\",\"choices\":[{\"message\":{\"content\":\"ok\"},\"finish_reason\":\"stop\"}],\"usage\":{\"prompt_tokens\":1,\"completion_tokens\":1,\"total_tokens\":2}}"
			})
		}
	})

	assert_false(result["ok"])
	assert_equal(result["error"]["code"], "concurrency_limit_exceeded")
}

test "queue-based admission control times out when slot never frees" {
	provider := openai_provider()
	client := create_client(provider, "fixture-key")
	client["in_flight_requests"] := 1
	messages := [create_message("user", "queue-timeout")]

	result := chat_completion(client, messages, {
		"max_in_flight_requests": 1,
		"queue_wait_timeout_ms": 1,
		"queue_poll_interval_ms": 1,
		"max_retries": 0,
		"transport": func(url, request_options) {
			return Ok({
				"_status": 200,
				"_body": "{\"id\":\"x\",\"choices\":[{\"message\":{\"content\":\"ok\"},\"finish_reason\":\"stop\"}],\"usage\":{\"prompt_tokens\":1,\"completion_tokens\":1,\"total_tokens\":2}}"
			})
		}
	})

	assert_false(result["ok"])
	assert_equal(result["error"]["code"], "concurrency_queue_timeout")
	assert_equal(result["status_code"], 429)
}

test "governance rejects request when per-request token budget is exceeded" {
	provider := openai_provider()
	client := create_client(provider, "fixture-key")
	messages := [create_message("user", "This prompt is intentionally long for governance testing")]

	result := chat_completion(client, messages, {
		"max_total_tokens_per_request": 5,
		"max_retries": 0,
		"transport": func(url, request_options) {
			return Ok({
				"_status": 200,
				"_body": "{\"choices\":[{\"message\":{\"content\":\"ok\"},\"finish_reason\":\"stop\"}],\"usage\":{\"prompt_tokens\":1,\"completion_tokens\":1,\"total_tokens\":2}}"
			})
		}
	})

	assert_false(result["ok"])
	assert_equal(result["error"]["code"], "governance_budget_exceeded")
	assert_equal(result["status_code"], 429)
	assert_equal(result["raw"]["budget_type"], "per_request_tokens")
}

test "governance rejects request when rolling token budget is already exhausted" {
	provider := openai_provider()
	client := create_client(provider, "fixture-key")
	messages := [create_message("user", "rolling token budget")]
	backend := {
		"state": {
			"ai_sdk:govtest:governance_tokens_used": 50
		}
	}

	result := chat_completion(client, messages, {
		"rolling_token_budget_tokens": 50,
		"state_backend": backend,
		"state_namespace": "govtest",
		"max_retries": 0,
		"transport": func(url, request_options) {
			return Ok({
				"_status": 200,
				"_body": "{\"choices\":[{\"message\":{\"content\":\"ok\"},\"finish_reason\":\"stop\"}],\"usage\":{\"prompt_tokens\":1,\"completion_tokens\":1,\"total_tokens\":2}}"
			})
		}
	})

	assert_false(result["ok"])
	assert_equal(result["error"]["code"], "governance_budget_exceeded")
	assert_equal(result["raw"]["budget_type"], "rolling_tokens")
}

test "governance rejects request when rolling cost budget would be exceeded" {
	provider := openai_provider()
	client := create_client(provider, "fixture-key")
	messages := [create_message("user", "rolling cost budget")]

	result := chat_completion(client, messages, {
		"rolling_cost_budget_cents": 0.01,
		"estimated_cost_per_1k_tokens_cents": 100.0,
		"max_retries": 0,
		"transport": func(url, request_options) {
			return Ok({
				"_status": 200,
				"_body": "{\"choices\":[{\"message\":{\"content\":\"ok\"},\"finish_reason\":\"stop\"}],\"usage\":{\"prompt_tokens\":10,\"completion_tokens\":10,\"total_tokens\":20}}"
			})
		}
	})

	assert_false(result["ok"])
	assert_equal(result["error"]["code"], "governance_budget_exceeded")
	assert_equal(result["raw"]["budget_type"], "rolling_cost")
}

test "retry classification handles status boundaries deterministically" {
	provider := openai_provider()
	client := create_client(provider, "fixture-key")

	http_429 := standard_error_response(client, "http_error", "HTTP 429", 429, null, false)
	http_499 := standard_error_response(client, "http_error", "HTTP 499", 499, null, true)
	http_500 := standard_error_response(client, "http_error", "HTTP 500", 500, null, false)
	http_599 := standard_error_response(client, "http_error", "HTTP 599", 599, null, false)

	assert_true(should_retry_error_result(http_429))
	assert_false(should_retry_error_result(http_499))
	assert_true(should_retry_error_result(http_500))
	assert_true(should_retry_error_result(http_599))
}

test "retry classification honors retryable fallback for non-http errors" {
	provider := openai_provider()
	client := create_client(provider, "fixture-key")

	transport_retryable := standard_error_response(client, "transport_error", "transient", 0, null, true)
	transport_non_retryable := standard_error_response(client, "transport_error", "fatal", 0, null, false)
	provider_non_retryable := standard_error_response(client, "provider_error", "invalid_request", 400, null, false)

	assert_true(should_retry_error_result(transport_retryable))
	assert_false(should_retry_error_result(transport_non_retryable))
	assert_false(should_retry_error_result(provider_non_retryable))
}

test "parse_json_contract handles empty and malformed payloads" {
	empty_result := parse_json_contract("")
	assert_false(empty_result["ok"])
	assert_equal(empty_result["error"], "empty body")

	malformed_result := parse_json_contract("{")
	assert_false(malformed_result["ok"])
	assert_true(len(malformed_result["error"]) > 0)
}

test "provider error normalization tolerates non-dict error shapes" {
	provider := openai_provider()
	client := create_client(provider, "fixture-key")

	raw_error := {
		"error": "provider-bad-shape"
	}
	result := normalize_provider_error(client, 400, raw_error)
	assert_false(result["ok"])
	assert_equal(result["error"]["code"], "provider_error")
	assert_equal(result["error"]["message"], "Provider returned an error")
}

test "raw payloads redact sensitive keys and bearer tokens" {
	provider := openai_provider()
	client := create_client(provider, "fixture-key")

	error_result := standard_error_response(client, "network_error", "boom", 0, {
		"Authorization": "Bearer sk-secret",
		"api_key": "top-secret",
		"nested": {
			"token": "abc123"
		}
	}, true)

	raw_serialized := to_json(error_result["raw"])
	assert_true(len(replace(raw_serialized, "[REDACTED]", "")) < len(raw_serialized))
	assert_equal(len(replace(raw_serialized, "top-secret", "")), len(raw_serialized))
	assert_equal(len(replace(raw_serialized, "abc123", "")), len(raw_serialized))
}

test "usage normalization handles total-only payload variant" {
	provider := openai_provider()
	client := create_client(provider, "fixture-key")

	total_only_usage := {
		"choices": [{"message": {"content": "ok"}}],
		"usage": {
			"total_tokens": 77
		}
	}
	result := normalize_non_stream_success(client, 200, total_only_usage, "fallback-model")
	assert_equal(result["usage"]["input_tokens"], 0)
	assert_equal(result["usage"]["output_tokens"], 0)
	assert_equal(result["usage"]["total_tokens"], 77)
}

test "sse parser supports multiline data frames and done markers" {
	body := "data: {\"id\":\"evt-1\",\"model\":\"gpt-4.1-mini\",\"choices\":[{\"delta\":{\"content\":\"Hello\"},\"finish_reason\":\"\"}]}\n\n"
	body := body + "data: {\"id\":\"evt-2\",\"choices\":[{\"delta\":{\"content\":\" world\"},\"finish_reason\":\"stop\"}]}\n"
	body := body + "data: [DONE]\n"
	body := body + "data: {\"id\":\"evt-3\",\"choices\":[]}\n"

	parsed_events := parse_sse_contract(body)
	assert_equal(len(parsed_events), 2)
	assert_equal(parsed_events[0]["id"], "evt-1")
	assert_equal(parsed_events[1]["id"], "evt-2")
}

test "stream normalization handles no-delta events" {
	provider := openai_provider()
	client := create_client(provider, "fixture-key")

	stream_events := [
		{
			"id": "evt-1",
			"choices": [
				{
					"delta": {},
					"finish_reason": "stop"
				}
			]
		}
	]

	result := normalize_stream_success(client, 200, stream_events, "fallback-model")
	assert_true(result["ok"])
	assert_equal(result["output_text"], "")
	assert_equal(result["finish_reason"], "stop")
}

test "stream normalization assembles chunked tool calls" {
	provider := openai_provider()
	client := create_client(provider, "fixture-key")
	stream_events := [
		{"choices":[{"delta":{"tool_calls":[{"index":0,"id":"call-1","type":"function","function":{"name":"relay.read_file","arguments":"{\"path\":"}}]},"finish_reason":""}]},
		{"choices":[{"delta":{"tool_calls":[{"index":0,"function":{"arguments":"\"README.md\"}"}}]},"finish_reason":"tool_calls"}]},
		{"choices":[],"usage":{"prompt_tokens":10,"completion_tokens":4,"total_tokens":14}}
	]
	result := normalize_stream_success(client,200,stream_events,"fallback-model")
	assert_true(result["ok"])
	assert_equal(result["finish_reason"],"tool_calls")
	assert_equal(result["tool_calls"][0]["function"]["name"],"relay.read_file")
	assert_equal(result["tool_calls"][0]["function"]["arguments"],"{\"path\":\"README.md\"}")
	assert_equal(result["usage"]["total_tokens"],14)
}

test "streaming returns normalized error when callback throws on done event" {
	provider := openai_provider()
	client := create_client(provider, "fixture-key")
	messages := [create_message("user", "Stream this")]

	handler := func(event) {
		if event["type"] == "done" {
			parse_json("{")
		}
	}

	result := chat_completion_stream(client, messages, {"offline_fixture": true}, handler)
	assert_false(result["ok"])
	assert_equal(result["error"]["code"], "stream_callback_error")
	assert_true(type(result["emitted_events"]) == "array")
	assert_true(len(result["emitted_events"]) > 0)
}

test "chat_completion supports injected transport success path" {

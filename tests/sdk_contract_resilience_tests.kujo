			"_body": "{\"id\":\"sz-1\",\"choices\":[{\"message\":{\"content\":\"ok\"},\"finish_reason\":\"stop\"}],\"usage\":{\"prompt_tokens\":1,\"completion_tokens\":1,\"total_tokens\":2}}"
		})
	}

	result := chat_completion(client, messages, {
		"transport": transport_ok,
		"max_retries": 0,
		"max_raw_response_bytes": 100000

test "response size guardrail rejects oversized provider body" {
	provider := openai_provider()
	client := create_client(provider, "fixture-key")
	messages := [create_message("user", "oversized")]

	transport_large := func(url, request_options) {
		return Ok({
			"_status": 200,
			"_body": "{\"choices\":[{\"message\":{\"content\":\"this body is far larger than the configured guardrail\"}}]}"
		})
	}

	result := chat_completion(client, messages, {
		"transport": transport_large,
		"max_retries": 0,
		"max_raw_response_bytes": 16
	})

	assert_false(result["ok"])
	assert_equal(result["error"]["code"], "response_too_large")
	assert_true(result["raw"]["response_bytes"] > result["raw"]["max_raw_response_bytes"])
}

test "response size guardrail allows body within budget" {

			"_body": "{\"id\":\"structured-1\",\"choices\":[{\"message\":{\"content\":\"not-json\"},\"finish_reason\":\"stop\"}],\"usage\":{\"prompt_tokens\":1,\"completion_tokens\":1,\"total_tokens\":2}}"
		})
	}

	result := chat_completion(client, messages, {
		"transport": transport_plain_text,
		"max_retries": 0,
		"structured_output_schema": {

	client := create_client(provider, "fixture-key")
	defaults := sdk_default_limits()
	resolved := resolve_options(client, null)

	assert_equal(defaults["temperature"], 0.2)
	assert_equal(defaults["max_tokens"], 400)
	assert_equal(defaults["max_retries"], 2)
	assert_equal(defaults["retry_budget"], 2)
	assert_equal(defaults["retry_jitter_ms"], 0)
	assert_equal(defaults["retry_delay_ms"], 300)
	assert_equal(defaults["max_retry_delay_ms"], 4000)
	assert_equal(defaults["timeout"], 45.0)
	assert_equal(defaults["connect_timeout"], 10.0)
	assert_equal(defaults["read_timeout"], 45.0)
	assert_equal(defaults["overall_timeout_ms"], 0)
	assert_equal(defaults["deadline_ms"], 0)
	assert_equal(type(defaults["structured_output_schema"]), "null")
	assert_true(defaults["structured_output_retryable"])
	assert_equal(type(defaults["fallback_providers"]), "array")
	assert_equal(len(defaults["fallback_providers"]), 0)
	assert_false(defaults["circuit_breaker_enabled"])
	assert_equal(defaults["circuit_breaker_error_threshold"], 5)
	assert_equal(defaults["circuit_breaker_cooldown_ms"], 15000)
	assert_true(defaults["circuit_breaker_half_open_enabled"])
	assert_equal(defaults["circuit_breaker_half_open_max_retries"], 0)
	assert_equal(type(defaults["state_backend"]), "null")
	assert_equal(defaults["state_namespace"], "")
	assert_equal(defaults["max_prompt_characters"], 20000)
	assert_equal(defaults["max_tools_per_request"], 32)
	assert_equal(defaults["max_in_flight_requests"], 4)
	assert_equal(defaults["queue_wait_timeout_ms"], 0)
	assert_equal(defaults["queue_poll_interval_ms"], 25)
	assert_equal(defaults["max_total_tokens_per_request"], 0)
	assert_equal(defaults["rolling_token_budget_tokens"], 0)
	assert_equal(defaults["rolling_cost_budget_cents"], 0.0)
	assert_equal(defaults["estimated_cost_per_1k_tokens_cents"], 0.0)
	assert_equal(defaults["trace_id"], "")

	assert_equal(resolved["temperature"], defaults["temperature"])
	assert_equal(resolved["max_tokens"], defaults["max_tokens"])
	assert_equal(resolved["max_retries"], defaults["max_retries"])
	assert_equal(resolved["retry_budget"], defaults["retry_budget"])
	assert_equal(resolved["retry_jitter_ms"], defaults["retry_jitter_ms"])
	assert_equal(resolved["retry_delay_ms"], defaults["retry_delay_ms"])
	assert_equal(resolved["max_retry_delay_ms"], defaults["max_retry_delay_ms"])
	assert_equal(resolved["timeout"], defaults["timeout"])
	assert_equal(resolved["connect_timeout"], defaults["connect_timeout"])
	assert_equal(resolved["read_timeout"], defaults["read_timeout"])
	assert_equal(resolved["overall_timeout_ms"], defaults["overall_timeout_ms"])
	assert_equal(resolved["deadline_ms"], defaults["deadline_ms"])
	assert_equal(type(resolved["structured_output_schema"]), "null")
	assert_equal(resolved["structured_output_retryable"], defaults["structured_output_retryable"])
	assert_equal(type(resolved["fallback_providers"]), "array")
	assert_equal(len(resolved["fallback_providers"]), 0)
	assert_equal(resolved["circuit_breaker_enabled"], defaults["circuit_breaker_enabled"])
	assert_equal(resolved["circuit_breaker_error_threshold"], defaults["circuit_breaker_error_threshold"])
	assert_equal(resolved["circuit_breaker_cooldown_ms"], defaults["circuit_breaker_cooldown_ms"])
	assert_equal(resolved["circuit_breaker_half_open_enabled"], defaults["circuit_breaker_half_open_enabled"])
	assert_equal(resolved["circuit_breaker_half_open_max_retries"], defaults["circuit_breaker_half_open_max_retries"])
	assert_equal(type(resolved["state_backend"]), "null")
	assert_equal(resolved["state_namespace"], "")
	assert_equal(resolved["max_prompt_characters"], defaults["max_prompt_characters"])
	assert_equal(resolved["max_tools_per_request"], defaults["max_tools_per_request"])
	assert_equal(resolved["max_in_flight_requests"], defaults["max_in_flight_requests"])
	assert_equal(resolved["queue_wait_timeout_ms"], defaults["queue_wait_timeout_ms"])
	assert_equal(resolved["queue_poll_interval_ms"], defaults["queue_poll_interval_ms"])
	assert_equal(resolved["max_total_tokens_per_request"], defaults["max_total_tokens_per_request"])
	assert_equal(resolved["rolling_token_budget_tokens"], defaults["rolling_token_budget_tokens"])
	assert_equal(resolved["rolling_cost_budget_cents"], defaults["rolling_cost_budget_cents"])
	assert_equal(resolved["estimated_cost_per_1k_tokens_cents"], defaults["estimated_cost_per_1k_tokens_cents"])

}

test "chat_completion stream parses incremental chunked SSE responses" {
	provider := openai_provider()
	client := create_client(provider, "fixture-key")
	messages := [create_message("user", "stream-chunks")]

	chunked_stream_transport := func(url, request_options) {
		return Ok({
			"_status": 200,
			"_body": "",
			"_stream_chunks": [
				"data: {\"id\":\"evt-1\",\"choices\":[{\"delta\":{\"content\":\"Hel",
				"lo\"},\"finish_reason\":\"\"}]}\n\n",
				"data: {\"id\":\"evt-2\",\"choices\":[{\"delta\":{\"content\":\" world\"},\"finish_reason\":\"stop\"}]}\n\n",
				"data: [DONE]\n\n"
			]
		})
	}

	result := chat_completion(client, messages, {
		"transport": chunked_stream_transport,
		"max_retries": 0,
		"stream": true
	})

	assert_true(result["ok"])
	assert_equal(result["output_text"], "Hello world")
	assert_equal(result["finish_reason"], "stop")
	assert_true(type(result["raw"]["stream_events"]) == "array")
	assert_equal(len(result["raw"]["stream_events"]), 2)
}


test_setup {
	from src.providers import openai_provider, deepseek_provider, custom_openai_compatible_provider, custom_openai_compatible_provider_with_options
	from src.ai_sdk import create_client, create_message, build_chat_payload, chat_completion, chat_completion_stream, embeddings, provider_supports, standard_error_response, normalize_provider_error, parse_json_contract, parse_sse_contract, should_retry_error_result, retry_delay_contract, merge_headers_for_request, normalize_non_stream_success, normalize_stream_success, resolve_options, sdk_default_limits, sdk_contract_version
}

test "resolve_options applies defaults and selected overrides" {
	provider := openai_provider()
	client := create_client(provider, "fixture-key")

	defaults := resolve_options(client, null)
	assert_equal(defaults["model"], provider["default_model"])
	assert_equal(defaults["temperature"], 0.2)
	assert_equal(defaults["max_tokens"], 400)
	assert_equal(defaults["max_retries"], 2)
	assert_equal(defaults["retry_budget"], 2)
	assert_equal(defaults["retry_jitter_ms"], 0)
	assert_equal(defaults["retry_delay_ms"], 300)
	assert_equal(defaults["max_retry_delay_ms"], 4000)
	assert_equal(defaults["timeout"], 45.0)
	assert_equal(defaults["connect_timeout"], 10.0)
	assert_equal(defaults["read_timeout"], 45.0)
	assert_equal(defaults["overall_timeout_ms"], 0)
	assert_equal(defaults["deadline_ms"], 0)
	assert_equal(type(defaults["structured_output_schema"]), "null")
	assert_true(defaults["structured_output_retryable"])
	assert_equal(type(defaults["fallback_providers"]), "array")
	assert_equal(len(defaults["fallback_providers"]), 0)
	assert_false(defaults["circuit_breaker_enabled"])
	assert_equal(defaults["circuit_breaker_error_threshold"], 5)
	assert_equal(defaults["circuit_breaker_cooldown_ms"], 15000)
	assert_true(defaults["circuit_breaker_half_open_enabled"])
	assert_equal(defaults["circuit_breaker_half_open_max_retries"], 0)
	assert_equal(type(defaults["state_backend"]), "null")
	assert_equal(defaults["state_namespace"], "")
	assert_equal(defaults["max_prompt_characters"], 20000)
	assert_equal(defaults["max_tools_per_request"], 32)
	assert_equal(defaults["max_in_flight_requests"], 4)
	assert_equal(defaults["queue_wait_timeout_ms"], 0)
	assert_equal(defaults["queue_poll_interval_ms"], 25)
	assert_equal(defaults["max_total_tokens_per_request"], 0)
	assert_equal(defaults["rolling_token_budget_tokens"], 0)
	assert_equal(defaults["rolling_cost_budget_cents"], 0.0)
	assert_equal(defaults["estimated_cost_per_1k_tokens_cents"], 0.0)
	assert_equal(defaults["trace_id"], "")
	assert_false(defaults["offline_fixture"])

	overrides := resolve_options(client, {
		"model": "gpt-4.1",
		"temperature": 0.5,
		"max_tokens": 120,
		"max_retries": 4,
		"retry_budget": 1,
		"retry_jitter_ms": 12,
		"retry_delay_ms": 150,
		"max_retry_delay_ms": 1200,
		"timeout": 12.0,
		"connect_timeout": 3.0,
		"read_timeout": 8.0,
		"overall_timeout_ms": 2500,
		"deadline_ms": 123456,
		"structured_output_schema": {"required": ["answer"]},
		"structured_output_retryable": false,
		"fallback_providers": [{"provider": openai_provider()}],
		"circuit_breaker_enabled": true,
		"circuit_breaker_error_threshold": 3,
		"circuit_breaker_cooldown_ms": 5000,
		"circuit_breaker_half_open_enabled": false,
		"circuit_breaker_half_open_max_retries": 1,
		"state_backend": {},
		"state_namespace": "tenant-a",
		"max_prompt_characters": 99,
		"max_tools_per_request": 5,
		"max_in_flight_requests": 2,
		"queue_wait_timeout_ms": 200,
		"queue_poll_interval_ms": 10,
		"max_total_tokens_per_request": 500,
		"rolling_token_budget_tokens": 1000,
		"rolling_cost_budget_cents": 250.0,
		"estimated_cost_per_1k_tokens_cents": 8.5,
		"trace_id": "trace-override",
		"offline_fixture": true,
		"allow_unsafe_header_override": true
	})
	assert_equal(overrides["model"], "gpt-4.1")
	assert_equal(overrides["temperature"], 0.5)
	assert_equal(overrides["max_tokens"], 120)
	assert_equal(overrides["max_retries"], 4)
	assert_equal(overrides["retry_budget"], 1)
	assert_equal(overrides["retry_jitter_ms"], 12)
	assert_equal(overrides["retry_delay_ms"], 150)
	assert_equal(overrides["max_retry_delay_ms"], 1200)
	assert_equal(overrides["timeout"], 12.0)
	assert_equal(overrides["connect_timeout"], 3.0)
	assert_equal(overrides["read_timeout"], 8.0)
	assert_equal(overrides["overall_timeout_ms"], 2500)
	assert_equal(overrides["deadline_ms"], 123456)
	assert_equal(type(overrides["structured_output_schema"]), "dict")
	assert_false(overrides["structured_output_retryable"])
	assert_equal(type(overrides["fallback_providers"]), "array")
	assert_equal(len(overrides["fallback_providers"]), 1)
	assert_true(overrides["circuit_breaker_enabled"])
	assert_equal(overrides["circuit_breaker_error_threshold"], 3)
	assert_equal(overrides["circuit_breaker_cooldown_ms"], 5000)
	assert_false(overrides["circuit_breaker_half_open_enabled"])
	assert_equal(overrides["circuit_breaker_half_open_max_retries"], 1)
	assert_equal(type(overrides["state_backend"]), "dict")
	assert_equal(overrides["state_namespace"], "tenant-a")
	assert_equal(overrides["max_prompt_characters"], 99)
	assert_equal(overrides["max_tools_per_request"], 5)
	assert_equal(overrides["max_in_flight_requests"], 2)
	assert_equal(overrides["queue_wait_timeout_ms"], 200)
	assert_equal(overrides["queue_poll_interval_ms"], 10)
	assert_equal(overrides["max_total_tokens_per_request"], 500)
	assert_equal(overrides["rolling_token_budget_tokens"], 1000)
	assert_equal(overrides["rolling_cost_budget_cents"], 250.0)
	assert_equal(overrides["estimated_cost_per_1k_tokens_cents"], 8.5)
	assert_equal(overrides["trace_id"], "trace-override")
	assert_true(overrides["offline_fixture"])
	assert_true(overrides["allow_unsafe_header_override"])
}

test "stream normalization supports structured delta content variants" {
	provider := openai_provider()
	client := create_client(provider, "fixture-key")

	stream_events := [
		{
			"id": "stream-1",
			"model": "gpt-4.1-mini",
			"choices": [
				{
					"delta": {
						"content": [
							{"text": "Hello "},
							{"content": "world"},
							{"content": "!"}
						]
					},
					"finish_reason": ""
				}
			]
		},
		{
			"choices": [
				{
					"delta": {
						"content": ""
					},
					"finish_reason": "stop"
				}
			]
		}
	]

	result := normalize_stream_success(client, 200, stream_events, "fallback-model")
	assert_true(result["ok"])
	assert_equal(result["output_text"], "Hello world!")
	assert_equal(result["finish_reason"], "stop")
}

test "sdk default constants are centralized and stable" {

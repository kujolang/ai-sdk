			"_status": 200,
			"_body": "{\"id\":\"transport-1\",\"model\":\"gpt-4.1-mini\",\"choices\":[{\"message\":{\"content\":\"hooked-response\"},\"finish_reason\":\"stop\"}],\"usage\":{\"prompt_tokens\":1,\"completion_tokens\":2,\"total_tokens\":3}}"
		})
	}

	result := chat_completion(client, messages, {
		"transport": transport_ok,
		"max_retries": 0

}

test "endpoint allowlist normalizes host case and trailing dot" {
	provider := custom_openai_compatible_provider("https://API.OpenAI.Com/v1", "OPENAI_API_KEY", "gpt-4.1-mini")
	client := create_client(provider, "fixture-key")
	messages := [create_message("user", "allowlist normalize")]

	transport_ok := func(url, request_options) {
		return Ok({
			"_status": 200,
			"_body": "{\"id\":\"allow-1\",\"choices\":[{\"message\":{\"content\":\"ok\"},\"finish_reason\":\"stop\"}],\"usage\":{\"prompt_tokens\":1,\"completion_tokens\":1,\"total_tokens\":2}}"
		})
	}

	allowed := chat_completion(client, messages, {
		"transport": transport_ok,
		"max_retries": 0,
		"endpoint_allowlist_enabled": true,
		"endpoint_allowlist_hosts": ["api.openai.com."]
	})
	assert_true(allowed["ok"])

	blocked := chat_completion(client, messages, {
		"transport": transport_ok,
		"max_retries": 0,
		"endpoint_allowlist_enabled": true,
		"endpoint_allowlist_hosts": ["api.openai.com.evil.test"]
	})
	assert_false(blocked["ok"])
	assert_equal(blocked["error"]["code"], "endpoint_policy_violation")
	assert_equal(blocked["status_code"], 403)
}

test "provider fallback succeeds on retryable primary failure" {
	provider := openai_provider()
	fallback_provider := custom_openai_compatible_provider("https://fallback.example/v1", "FALLBACK_API_KEY", "fallback-model")
	client := create_client(provider, "fixture-key")
	messages := [create_message("user", "fallback")]

	transport_with_fallback := func(url, request_options) {
		if starts_with(url, "https://api.openai.com/v1") {
			return Err("primary timeout")
		}
		if starts_with(url, "https://fallback.example/v1") {
			return Ok({
				"_status": 200,
				"_body": "{\"id\":\"fallback-1\",\"model\":\"fallback-model\",\"choices\":[{\"message\":{\"content\":\"fallback-ok\"},\"finish_reason\":\"stop\"}],\"usage\":{\"prompt_tokens\":1,\"completion_tokens\":1,\"total_tokens\":2}}"
			})
		}
		return Err("unexpected url")
	}

	result := chat_completion(client, messages, {
		"transport": transport_with_fallback,
		"max_retries": 0,
		"fallback_providers": [
			{"provider": fallback_provider}
		]
	})

	assert_true(result["ok"])
	assert_equal(result["output_text"], "fallback-ok")
	assert_true(has_key(result, "fallback") == 1)
	assert_equal(result["fallback"]["provider"], "openai-compatible")
}

test "provider fallback is skipped on non-retryable primary error" {
	provider := openai_provider()
	fallback_provider := custom_openai_compatible_provider("https://fallback.example/v1", "FALLBACK_API_KEY", "fallback-model")
	client := create_client(provider, "fixture-key")
	messages := [create_message("user", "fallback-skip")]

	transport_primary_http_400 := func(url, request_options) {
		if starts_with(url, "https://api.openai.com/v1") {
			return Ok({
				"_status": 400,
				"_body": "{\"error\":{\"message\":\"bad request\"}}"
			})
		}
		return Ok({
			"_status": 200,
			"_body": "{\"choices\":[{\"message\":{\"content\":\"should-not-run\"},\"finish_reason\":\"stop\"}]}"
		})
	}

	result := chat_completion(client, messages, {
		"transport": transport_primary_http_400,
		"max_retries": 0,
		"fallback_providers": [
			{"provider": fallback_provider}
		]
	})

	assert_false(result["ok"])
	assert_equal(result["error"]["code"], "provider_error")
	assert_equal(has_key(result, "fallback"), 0)
}

test "observability hooks emit request start and complete events" {
	provider := openai_provider()
	client := create_client(provider, "fixture-key")
	messages := [create_message("user", "observe")]
	metrics := {
		"start_count": 0,
		"complete_count": 0,
		"last_status": 0
	}

	on_start := func(event) {
		metrics["start_count"] := metrics["start_count"] + 1
	}
	on_complete := func(event) {
		metrics["complete_count"] := metrics["complete_count"] + 1
		metrics["last_status"] := event["status_code"]
	}
	transport_ok := func(url, request_options) {
		return Ok({
			"_status": 200,
			"_body": "{\"id\":\"obs-1\",\"model\":\"gpt-4.1-mini\",\"choices\":[{\"message\":{\"content\":\"ok\"},\"finish_reason\":\"stop\"}],\"usage\":{\"prompt_tokens\":1,\"completion_tokens\":1,\"total_tokens\":2}}"
		})
	}

	result := chat_completion(client, messages, {
		"transport": transport_ok,
		"on_request_start": on_start,
		"on_request_complete": on_complete,
		"max_retries": 0
	})
	assert_true(result["ok"])
	assert_equal(result["observability"]["start_count"], 1)
	assert_equal(result["observability"]["complete_count"], 1)
	assert_equal(result["observability"]["retry_count"], 0)
	assert_equal(result["status_code"], 200)
	assert_true(len(result["observability"]["trace_id"]) > 0)
	assert_true(len(result["observability"]["request_id"]) > 0)
	assert_true(result["observability"]["duration_ms"] >= 0)
}

test "observability hooks emit retry events" {
	provider := openai_provider()
	client := create_client(provider, "fixture-key")
	messages := [create_message("user", "observe-retry")]
	metrics := {
		"retry_count": 0,
		"calls": 0,
		"last_delay": 0
	}

	on_retry := func(event) {
		metrics["retry_count"] := metrics["retry_count"] + 1
		metrics["last_delay"] := event["delay_ms"]
	}
	transport_retry := func(url, request_options) {
		metrics["calls"] := metrics["calls"] + 1
		if metrics["calls"] == 1 {
			return Err("transient timeout")
		}
		return Ok({
			"_status": 200,
			"_body": "{\"id\":\"obs-2\",\"model\":\"gpt-4.1-mini\",\"choices\":[{\"message\":{\"content\":\"ok\"},\"finish_reason\":\"stop\"}],\"usage\":{\"prompt_tokens\":1,\"completion_tokens\":1,\"total_tokens\":2}}"
		})
	}

	result := chat_completion(client, messages, {
		"transport": transport_retry,
		"on_retry": on_retry,
		"max_retries": 1,
		"retry_delay_ms": 1
	})
	assert_true(result["ok"])
	assert_equal(result["observability"]["retry_count"], 1)
	assert_equal(result["observability"]["start_count"], 2)
	assert_equal(result["observability"]["complete_count"], 2)
	assert_equal(result["status_code"], 200)
}

test "structured output request fails fast when provider lacks json_mode" {
	limited_provider := {
		"name": "limited",
		"base_url": "https://limited.example/v1",
		"chat_path": "/chat/completions",
		"api_key_env": "LIMITED_API_KEY",
		"default_model": "limited-model",
		"capabilities": {
			"streaming": true,
			"tool_calls": true,
			"json_mode": false,
			"embeddings": true
		}
	}
	client := create_client(limited_provider, "fixture-key")
	messages := [create_message("user", "structured but unsupported")]

	transport_should_not_run := func(url, request_options) {
		return Ok({
			"_status": 200,
			"_body": "{\"choices\":[{\"message\":{\"content\":\"{}\"},\"finish_reason\":\"stop\"}]}"
		})
	}

	result := chat_completion(client, messages, {
		"transport": transport_should_not_run,
		"max_retries": 0,
		"structured_output_schema": {"required": ["answer"]}
	})

	assert_false(result["ok"])
	assert_equal(result["error"]["code"], "unsupported_feature")
}


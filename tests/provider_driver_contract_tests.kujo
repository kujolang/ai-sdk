test_setup { from src.provider_driver import provider_driver_contract_version, validate_provider_driver, resolve_provider_driver; from src.providers import openai_provider; from tests.fixtures.fictional_provider_driver import fictional_provider, fictional_provider_driver; from src.ai_sdk import create_client }
test "driver contract is independently versioned" { assert_equal(provider_driver_contract_version(),"1.0.0"); assert_true(validate_provider_driver(fictional_provider_driver(),fictional_provider())["ok"]) }
test "malformed versions and hooks fail" { d:=fictional_provider_driver(); d["version"]="2.0.0"; d["encode_chat"]="bad"; result:=validate_provider_driver(d,fictional_provider()); assert_false(result["ok"]); assert_true(len(result["errors"])>=2) }
test "capability hook pairs are enforced" { d:=fictional_provider_driver(); d["decode_embeddings"]=null; assert_false(validate_provider_driver(d,fictional_provider())["ok"]); d:=fictional_provider_driver(); d["decode_stream"]=null; assert_false(validate_provider_driver(d,fictional_provider())["ok"]) }
test "legacy providers resolve implicitly" { r:=resolve_provider_driver(openai_provider()); assert_true(r["ok"]); assert_equal(r["source"],"legacy_openai_compatible"); assert_equal(create_client(openai_provider(),"key")["driver"]["id"],"openai-compatible") }
test "explicit drivers resolve from provider" { r:=resolve_provider_driver(fictional_provider()); assert_true(r["ok"]); assert_equal(r["source"],"provider") }

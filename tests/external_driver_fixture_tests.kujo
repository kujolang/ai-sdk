test_setup { from tests.fixtures.fictional_provider_driver import fictional_provider; from src.ai_sdk import create_client, create_message, chat_completion, chat_completion_stream, embeddings }
test "fictional native auth payload and response normalize" { client:=create_client(fictional_provider(),"test-key"); transport:=func(url,o){ assert_equal(url,"https://fictional.invalid/v1/conversation"); assert_equal(o["_headers"]["x-api-key"],"test-key"); body:=parse_json(o["_body"]); assert_equal(body["conversation"][0],{"speaker":"human","text":"Hello"}); return Ok({"_status":200,"_body":"{\"reply\":{\"text\":\"Hello from fictional provider\"},\"metrics\":{\"input\":10,\"output\":5}}"}) }; r:=chat_completion(client,[create_message("user","Hello")],{"transport":transport,"max_retries":0}); assert_true(r["ok"]); assert_equal(r["output_text"],"Hello from fictional provider"); assert_equal(r["usage"]["total_tokens"],15); assert_equal(r["contract_version"],"1.0.0") }
test "fictional native errors preserve stable taxonomy" { r:=chat_completion(create_client(fictional_provider(),"key"),[create_message("user","x")],{"transport":func(u,o){return Ok({"_status":429,"_body":"{\"failure\":{\"reason\":\"Rate limited\",\"code\":\"TOO_FAST\"}}"})},"max_retries":0}); assert_equal(r["error"]["code"],"provider_error"); assert_equal(r["error"]["provider_code"],"TOO_FAST"); assert_true(r["error"]["retryable"]) }
test "fictional native stream preserves buffered events" { r:=chat_completion_stream(create_client(fictional_provider(),"key"),[create_message("user","x")],{"transport":func(u,o){return Ok({"_status":200,"_stream_chunks":["piece|Hello \npiece|world\nstats|3|2\nend|complete|stream-1\n"]})},"max_retries":0},null); assert_true(r["ok"]); assert_equal(r["output_text"],"Hello world"); assert_equal(r["emitted_events"][0]["type"],"delta"); assert_equal(r["emitted_events"][len(r["emitted_events"])-1]["type"],"done") }
test "fictional native embeddings normalize" { r:=embeddings(create_client(fictional_provider(),"key"),["a","b"],{"transport":func(u,o){assert_equal(u,"https://fictional.invalid/v1/vectorize"); return Ok({"_status":200,"_body":"{\"vectors\":[{\"position\":0,\"values\":[0.1]},{\"position\":1,\"values\":[0.2]}],\"metrics\":{\"input\":4}}"})},"max_retries":0}); assert_true(r["ok"]); assert_equal(r["embeddings"][1]["vector"],[0.2]) }
test "native protected headers resist case variants" { r:=chat_completion(create_client(fictional_provider(),"key"),[create_message("user","x")],{"headers":{"X-API-KEY":"stolen","CONTENT-TYPE":"text/plain","X-Bad":"x\r\ny"},"transport":func(u,o){assert_equal(o["_headers"]["x-api-key"],"key"); assert_equal(o["_headers"]["Content-Type"],"application/fictional+json"); assert_equal(has_key(o["_headers"],"X-API-KEY"),0); return Ok({"_status":200,"_body":"{\"reply\":{\"text\":\"ok\"},\"metrics\":{\"input\":1,\"output\":1}}"})},"max_retries":0}); assert_true(r["ok"]) }

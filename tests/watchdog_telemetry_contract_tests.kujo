test_setup {
	from src.ai_sdk import normalize_usage_contract
	from src.watchdog_telemetry import watchdog_model_event
}

test "usage normalization preserves provider distinctions" {
	usage := normalize_usage_contract({
		"prompt_tokens": 10, "completion_tokens": 4, "total_tokens": 14,
		"prompt_tokens_details": {"cached_tokens": 3},
		"completion_tokens_details": {"reasoning_tokens": 2},
		"cache_creation_input_tokens": 1
	}, {"input_tokens": 0, "output_tokens": 0, "total_tokens": 0})
	assert_equal(usage["input_tokens"], 10)
	assert_equal(usage["output_tokens"], 4)
	assert_equal(usage["cached_input_tokens"], 3)
	assert_equal(usage["cache_write_input_tokens"], 1)
	assert_equal(usage["reasoning_tokens"], 2)
	assert_equal(usage["provider_usage"]["prompt_tokens"], 10)
}

test "Watchdog model adapter is metadata only and provider neutral" {
	mapped := watchdog_model_event({
		"event_id": "event-1", "trace_id": "trace-1", "span_id": "span-1", "session_id": "session-1",
		"started_at_ms": 10, "ended_at_ms": 20, "operation": "chat",
		"result": {"ok": true, "provider": "anthropic", "model": "claude-fixture", "request_id": "provider-request", "output_text": "secret", "raw": {"prompt": "secret"}, "usage": {"input_tokens": 2, "output_tokens": 1, "total_tokens": 3}}
	})
	assert_true(mapped["ok"])
	event := mapped["event"]
	assert_equal(event["attributes"]["gen_ai.provider.name"], "anthropic")
	assert_equal(event["usage"]["total_tokens"], 3)
	encoded := to_json(event)
	assert_equal(contains(encoded, "secret"), 0)
	assert_equal(contains(encoded, "output_text"), 0)
	assert_equal(contains(encoded, "raw"), 0)
}

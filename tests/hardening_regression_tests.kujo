test_setup {
 from tests.fixtures.governance_backend import file_backend
 from src.providers import openai_provider
 from src.ai_sdk import create_client, create_message, chat_completion, embeddings, normalize_provider_error, normalize_stream_success
}

test "throwing transports return terminal errors for chat and embeddings" {
 client := create_client(openai_provider(), "fixture-key")
 options := {"transport": func(u, o) { parse_json("{") }, "max_retries": 2}
 result := chat_completion(client, [create_message("user", "x")], options)
 assert_false(result["ok"])
 assert_equal(result["error"]["code"], "transport_error")
 assert_false(result["error"]["retryable"])
 assert_equal(result["observability"]["start_count"], 1)
 assert_equal(client["in_flight_requests"], 0)
 result = embeddings(client, "x", options)
 assert_equal(result["error"]["code"], "transport_error")
 assert_false(result["error"]["retryable"])
}

test "normalized provider error metadata cannot expose the configured credential" {
 client := create_client(openai_provider(), "private-fixture-credential")
 result := normalize_provider_error(client, 401, {"error": {
  "message": "Rejected private-fixture-credential", "type": "private-fixture-credential",
  "param": "private-fixture-credential", "code": "private-fixture-credential"
 }})
 assert_equal(contains(to_json(result), "private-fixture-credential"), 0)
}


test "rejected driver descriptors release the chat admission slot" {
 provider := openai_provider()
 provider["chat_path"] = "/chat?forbidden=true"
 client := create_client(provider, "fixture-key")
 for attempt in range(0, 6) {
  result := chat_completion(client, [create_message("user", "x")], {"max_retries": 0})
  assert_equal(result["error"]["code"], "endpoint_policy_violation")
  assert_equal(client["in_flight_requests"], 0)
  assert_equal(result["observability"]["start_count"], 0)
 }
}

test "stream usage metadata survives subsequent events without usage" {
 client := create_client(openai_provider(), "fixture-key")
 result := normalize_stream_success(client, 200, [
  {"choices": [], "usage": {"prompt_tokens": 10, "completion_tokens": 4, "prompt_tokens_details": {"cached_tokens": 3}, "completion_tokens_details": {"reasoning_tokens": 2}}},
  {"choices": [{"delta": {"content": "done"}, "finish_reason": "stop"}], "usage": null}
 ], "fixture-model")
 assert_equal(result["usage"]["total_tokens"], 14)
 assert_equal(result["usage"]["cached_input_tokens"], 3)
 assert_equal(result["usage"]["reasoning_tokens"], 2)
 assert_equal(result["usage"]["total_semantics"], "input_plus_output")
 assert_equal(result["usage"]["provider_usage"]["prompt_tokens"], 10)
}

test "chat token overruns remain charged and block the next request" {
 client := create_client(openai_provider(), "fixture-key")
 path := "tests/governance.tmp-" + uuid_v4()
 backend := file_backend(path)
 options := {"offline_fixture": true, "rolling_token_budget_tokens": 10, "state_backend": backend}
 first := chat_completion(client, [], options)
 second := chat_completion(create_client(openai_provider(), "fixture-key"), [], options)
 stored := parse_json(read_file(path))
 delete_file(path)
 assert_equal(stored["ai_sdk:openai:governance_tokens_used"], 20)
 assert_equal(first["raw"]["request_tokens"], 20)
 assert_equal(second["error"]["code"], "governance_budget_exceeded")
 assert_equal(second["raw"]["used_tokens"], 20)
 assert_equal(has_key(second["raw"], "request_tokens"), 0)
}

test "embedding cost overruns retain both accounting counters" {
 client := create_client(openai_provider(), "fixture-key")
 path := "tests/governance.tmp-" + uuid_v4()
 backend := file_backend(path)
 options := {"offline_fixture": true, "rolling_cost_budget_cents": 1.0, "estimated_cost_per_1k_tokens_cents": 1000.0, "state_backend": backend}
 first := embeddings(client, "x", options)
 second := embeddings(create_client(openai_provider(), "fixture-key"), "x", options)
 stored := parse_json(read_file(path))
 delete_file(path)
 assert_equal(stored["ai_sdk:openai:governance_tokens_used"], 4)
 assert_equal(stored["ai_sdk:openai:governance_cost_cents_used"], 4.0)
 assert_equal(first["error"]["code"], "governance_budget_exceeded")
 assert_equal(second["raw"]["used_cost_cents"], 4.0)
 assert_equal(has_key(second["raw"], "request_cost_cents"), 0)
}


test "structured output retries charge completed provider usage" {
 path := "tests/governance.tmp-" + uuid_v4()
 backend := file_backend(path)
 client := create_client(openai_provider(), "fixture-key")
 result := chat_completion(client, [], {
  "state_backend": backend,
  "rolling_token_budget_tokens": 10,
  "structured_output_schema": {"required": ["answer"]},
  "max_retries": 2, "retry_delay_ms": 0,
  "transport": func(u, o) {
   return Ok({"_status": 200, "_body": "{\"choices\":[{\"message\":{\"content\":\"{}\"}}],\"usage\":{\"total_tokens\":5}}"})
  }
 })
 stored := parse_json(read_file(path))
 delete_file(path)
 assert_equal(stored["ai_sdk:openai:governance_tokens_used"], 10)
 assert_equal(result["error"]["code"], "governance_budget_exceeded")
 assert_equal(result["observability"]["start_count"], 2)
 assert_equal(result["observability"]["complete_count"], 2)
}

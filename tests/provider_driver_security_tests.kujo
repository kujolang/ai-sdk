test_setup { from tests.fixtures.provider_driver_security_fixture import security_provider; from src.ai_sdk import create_client,create_message,chat_completion,chat_completion_stream }
test "driver host scheme and localhost bypasses fail" { for mode in ["host","http","localhost"] { r:=chat_completion(create_client(security_provider(mode),"super-secret"),[create_message("user","x")],{"transport":func(u,o){return Err("must not run")},"max_retries":0}); assert_equal(r["error"]["code"],"endpoint_policy_violation") } }
test "provider allowlist cannot authorize a driver host transition" { r:=chat_completion(create_client(security_provider("host"),"super-secret"),[create_message("user","x")],{"transport":func(u,o){return Err("must not run")},"endpoint_allowlist_enabled":true,"endpoint_allowlist_hosts":["fictional.invalid"],"max_retries":0}); assert_equal(r["error"]["code"],"endpoint_policy_violation") }
test "credentials cannot leak through query body or unprotected header" { for mode in ["query","body","header"] { r:=chat_completion(create_client(security_provider(mode),"super-secret"),[create_message("user","x")],{"transport":func(u,o){return Err("must not run")},"max_retries":0}); assert_equal(r["error"]["code"],"endpoint_policy_violation") } }
test "descriptor control characters methods and shapes fail" { for mode in ["crlf","get","shape"] { r:=chat_completion(create_client(security_provider(mode),"super-secret"),[create_message("user","x")],{"transport":func(u,o){return Err("must not run")},"max_retries":0}); assert_equal(r["error"]["code"],"config_error") } }
test "driver exceptions and malformed semantic results are contained" { for mode in ["throw_encode","throw_decode","malformed_decode"] { r:=chat_completion(create_client(security_provider(mode),"super-secret"),[create_message("user","x")],{"transport":func(u,o){return Ok({"_status":200,"_body":"{\"reply\":{\"text\":\"x\"}}"})},"max_retries":0}); assert_false(r["ok"]); assert_true(r["error"]["code"]=="config_error" || r["error"]["code"]=="invalid_response") } }
test "invalid and throwing driver metadata fail configuration" { for mode in ["bad_metadata","throw_metadata"] { client:=create_client(security_provider(mode),"key"); assert_true(client["config_error"]!="") } }
test "oversized bodies and chunks remain core enforced" { p:=security_provider("normal"); body:=chat_completion(create_client(p,"key"),[create_message("user","x")],{"transport":func(u,o){return Ok({"_status":200,"_body":"this is much too large"})},"max_raw_response_bytes":4,"max_retries":0}); assert_equal(body["error"]["code"],"response_too_large"); stream:=chat_completion_stream(create_client(p,"key"),[create_message("user","x")],{"transport":func(u,o){return Ok({"_status":200,"_stream_chunks":["piece|this is too large\n"]})},"max_raw_response_bytes":4,"max_retries":0},null); assert_equal(stream["error"]["code"],"response_too_large") }
test "retry hints cannot amplify terminal failures" { r:=chat_completion(create_client(security_provider("normal"),"key"),[create_message("user","x")],{"transport":func(u,o){return Ok({"_status":400,"_body":"{\"failure\":{\"reason\":\"bad\",\"code\":\"BAD\"}}"})},"max_retries":3}); assert_false(r["error"]["retryable"]); assert_equal(r["status_code"],400); assert_equal(r["observability"]["start_count"],1) }

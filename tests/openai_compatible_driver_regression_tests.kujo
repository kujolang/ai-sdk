test_setup { from src.providers import openai_provider, openrouter_provider, deepseek_provider, custom_openai_compatible_provider_with_options; from src.ai_sdk import create_client, create_message, chat_completion, embeddings; from src.openai_compatible_driver import openai_compatible_driver }
test "legacy presets retain Bearer request and normalized response" { for p in [openai_provider(),openrouter_provider(),deepseek_provider()] { r:=chat_completion(create_client(p,"key"),[create_message("user","hello")],{"transport":func(u,o){assert_equal(o["_headers"]["Authorization"],"Bearer key"); return Ok({"_status":200,"_body":"{\"id\":\"x\",\"choices\":[{\"message\":{\"content\":\"ok\"},\"finish_reason\":\"stop\"}],\"usage\":{\"prompt_tokens\":1,\"completion_tokens\":1,\"total_tokens\":2}}"})},"max_retries":0}); assert_true(r["ok"]); assert_equal(r["output_text"],"ok") } }
test "custom legacy provider needs no driver" { p:=custom_openai_compatible_provider_with_options("https://custom.invalid/v1","KEY","model",false); assert_equal(has_key(p,"driver"),0); r:=chat_completion(create_client(p,"key"),[create_message("user","x")],{"transport":func(u,o){assert_equal(u,"https://custom.invalid/v1/chat/completions"); return Ok({"_status":200,"_body":"{\"choices\":[{\"message\":{\"content\":\"ok\"}}]}"})},"max_retries":0}); assert_true(r["ok"]) }
test "OpenAI embeddings retain wire shape" { r:=embeddings(create_client(openai_provider(),"key"),"x",{"transport":func(u,o){assert_equal(u,"https://api.openai.com/v1/embeddings"); return Ok({"_status":200,"_body":"{\"data\":[{\"index\":0,\"embedding\":[0.1]}],\"usage\":{\"prompt_tokens\":1,\"total_tokens\":1}}"})},"max_retries":0}); assert_true(r["ok"]); assert_equal(r["embeddings"][0]["vector"],[0.1]) }
test "reusable OpenAI driver hooks encode and decode semantic data" { d:=openai_compatible_driver(); encoded:=d["encode_chat"]({"provider":openai_provider(),"credential":"key","payload":{"model":"gpt"},"resolved_options":{"stream":false}}); assert_equal(encoded["headers"]["Authorization"],"Bearer key"); semantic:=d["decode_chat"]({"data":{"id":"x","choices":[{"message":{"content":"decoded"},"finish_reason":"stop"}],"usage":{"prompt_tokens":1,"completion_tokens":2}},"fallback_model":"gpt"}); assert_true(semantic["ok"]); assert_equal(semantic["output_text"],"decoded"); assert_equal(semantic["usage"]["total_tokens"],3) }

func decode_embeddings(context) { d:=context["data"]; vectors:=[]; for item in d["vectors"] { vectors=push(vectors,{"index":item["position"],"vector":item["values"]}) }; input:=d["metrics"]["input"]; return {"ok":true,"model":context["fallback_model"],"embeddings":vectors,"usage":{"input_tokens":input,"total_tokens":input},"raw_provider":d} }
func driver() { return {"contract":"ai-sdk-provider-driver","version":"1.0.0","id":"fictional-native-v1","describe":describe,"validate":validate,"encode_chat":encode_chat,"decode_chat":decode_chat,"decode_error":decode_error,"decode_stream":decode_stream,"encode_embeddings":encode_embeddings,"decode_embeddings":decode_embeddings} }

test_setup {
 from src.ai_sdk import create_client, chat_completion, chat_completion_stream, embeddings
 from src.providers import openai_provider
}

test "transport receives download bound and no redirects under endpoint policy" {
 client := create_client(openai_provider(), "key")
 options := {"endpoint_allowlist_enabled": true, "endpoint_allowlist_hosts": ["api.openai.com"], "max_raw_response_bytes": 64, "max_retries": 0,
  "transport": func(url, request) {
   assert_equal(request["redirects"], "none")
   assert_equal(request["max_response_bytes"], 64)
   return Err("fixture")
  }}
 assert_equal(chat_completion(client, [], options)["error"]["code"], "network_error")
 assert_equal(embeddings(client, "x", options)["error"]["code"], "network_error")
}

test "legacy redirect behavior and runtime ceiling remain compatible" {
 client := create_client(openai_provider(), "key")
 options := {"max_raw_response_bytes": 10000000, "max_retries": 0,
  "transport": func(url, request) {
   assert_equal(request["redirects"], "follow")
   assert_equal(request["max_response_bytes"], 8388608)
   return Err("fixture")
  }}
 assert_equal(chat_completion(client, [], options)["error"]["code"], "network_error")
}

test "invalid redirect and incremental custom transport options fail before transport" {
 client := create_client(openai_provider(), "key")
 for options in [{"redirects": "sometimes"}, {"on_transport_chunk": "invalid"}, {"on_transport_chunk": func(e) {}, "transport": func(u,o) {throw "must not call"}}] {
  result := chat_completion(client, [], options)
  assert_equal(result["error"]["code"], "config_error")
  assert_equal(result["error"]["retryable"], false)
 }
}

test "injected UTF-8 bodies and chunks respect the wire byte limit" {
 client := create_client(openai_provider(), "key")
 body := "{\"choices\":[{\"message\":{\"content\":\"é\"}}]}"
 options := {
  "transport": func(url, request) { return Ok({"_status": 200, "_body": body}) },
  "max_retries": 0, "max_raw_response_bytes": byte_length(body) - 1
 }
 error := chat_completion(client, [], options)
 assert_equal(error["error"]["code"], "response_too_large")
 assert_equal(error["raw"]["response_bytes"], byte_length(body))
 options["max_raw_response_bytes"] = byte_length(body)
 assert_equal(chat_completion(client, [], options)["output_text"], "é")

 chunk := "data: {\"choices\":[{\"delta\":{\"content\":\"é\"},\"finish_reason\":\"stop\"}]}\n\n"
 options["transport"] = func(url, request) { return Ok({"_status": 200, "_stream_chunks": [chunk]}) }
 options["max_raw_response_bytes"] = byte_length(chunk) - 1
 error = chat_completion_stream(client, [], options, null)
 assert_equal(error["error"]["code"], "response_too_large")
 assert_equal(error["raw"]["response_bytes"], byte_length(chunk))
 options["max_raw_response_bytes"] = byte_length(chunk)
 assert_equal(chat_completion_stream(client, [], options, null)["output_text"], "é")
}

test "credential carrying extension headers disable redirects in chat and embeddings" {
    client := create_client(openai_provider(),"fixture-key")
    transport := func(url, request) {
        assert_equal(request["redirects"],"none")
        return Err("fixture transport reached")
    }
    options := {"headers":{"x-goog-api-key":"configured-header"},"redirects":"follow","transport":transport,"max_retries":0}
    assert_equal(chat_completion(client,[],options)["error"]["code"],"network_error")
    options["headers"] = {"x-tenant-routing":"fixture-key"}
    assert_equal(embeddings(client,"fixture text",options)["error"]["code"],"network_error")
}

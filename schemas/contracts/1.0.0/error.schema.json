{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://github.com/kujolang/ai-sdk/schemas/contracts/1.0.0/error.schema.json",
	"title": "AI SDK Error Contract",
	"type": "object",
	"required": [
		"ok",
		"provider",
		"contract_version",
		"error",
		"status_code",
		"normalized_at",
		"raw"
	],
	"properties": {
		"ok": {
			"const": false
		},
		"provider": {
			"type": "string",
			"minLength": 1
		},
		"contract_version": {
			"const": "1.0.0"
		},
		"error": {
			"type": "object",
			"required": [
				"code",
				"message",
				"retryable"
			],
			"properties": {
				"code": {
					"type": "string",
					"minLength": 1
				},
				"message": {
					"type": "string",
					"minLength": 1
				},
				"retryable": {
					"type": "boolean"
				}
			},
			"additionalProperties": true
		},
		"status_code": {
			"type": "integer",
			"minimum": 0,
			"maximum": 599
		},
		"normalized_at": {
			"type": "integer",
			"minimum": 0
		},
		"raw": {
			"type": [
				"object",
				"array",
				"string",
				"number",
				"boolean",
				"null"
			]
		}
	},
	"additionalProperties": true
}
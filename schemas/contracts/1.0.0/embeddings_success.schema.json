{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://github.com/kujolang/ai-sdk/schemas/contracts/1.0.0/embeddings_success.schema.json",
	"title": "AI SDK Embeddings Success Contract",
	"type": "object",
	"required": [
		"ok",
		"provider",
		"contract_version",
		"model",
		"embeddings",
		"usage",
		"status_code",
		"normalized_at",
		"raw"
	],
	"properties": {
		"ok": {
			"const": true
		},
		"provider": {
			"type": "string",
			"minLength": 1
		},
		"contract_version": {
			"const": "1.0.0"
		},
		"model": {
			"type": "string",
			"minLength": 1
		},
		"embeddings": {
			"type": "array",
			"items": {
				"type": "object",
				"required": [
					"index",
					"vector"
				],
				"properties": {
					"index": {
						"type": "integer",
						"minimum": 0
					},
					"vector": {
						"type": "array",
						"items": {
							"type": "number"
						}
					}
				},
				"additionalProperties": true
			}
		},
		"usage": {
			"type": "object",
			"required": [
				"input_tokens",
				"total_tokens"
			],
			"properties": {
				"input_tokens": {
					"type": "integer",
					"minimum": 0
				},
				"total_tokens": {
					"type": "integer",
					"minimum": 0
				}
			},
			"additionalProperties": true
		},
		"status_code": {
			"type": "integer",
			"minimum": 100,
			"maximum": 599
		},
		"normalized_at": {
			"type": "integer",
			"minimum": 0
		},
		"raw": {
			"type": [
				"object",
				"array",
				"string",
				"number",
				"boolean",
				"null"
			]
		}
	},
	"additionalProperties": true
}
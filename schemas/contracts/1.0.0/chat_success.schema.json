{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://github.com/kujolang/ai-sdk/schemas/contracts/1.0.0/chat_success.schema.json",
	"title": "AI SDK Chat Success Contract",
	"type": "object",
	"required": [
		"ok",
		"provider",
		"contract_version",
		"request_id",
		"model",
		"output_text",
		"finish_reason",
		"tool_calls",
		"usage",
		"status_code",
		"normalized_at",
		"raw"
	],
	"properties": {
		"ok": {
			"const": true
		},
		"provider": {
			"type": "string",
			"minLength": 1
		},
		"contract_version": {
			"const": "1.0.0"
		},
		"request_id": {
			"type": "string",
			"minLength": 1
		},
		"model": {
			"type": "string",
			"minLength": 1
		},
		"output_text": {
			"type": "string"
		},
		"finish_reason": {
			"type": "string"
		},
		"tool_calls": {
			"type": "array"
		},
		"usage": {
			"type": "object",
			"required": [
				"input_tokens",
				"output_tokens",
				"total_tokens"
			],
			"properties": {
				"input_tokens": {
					"type": "integer",
					"minimum": 0
				},
				"output_tokens": {
					"type": "integer",
					"minimum": 0
				},
				"total_tokens": {
					"type": "integer",
					"minimum": 0
				}
			},
			"additionalProperties": true
		},
		"status_code": {
			"type": "integer",
			"minimum": 100,
			"maximum": 599
		},
		"normalized_at": {
			"type": "integer",
			"minimum": 0
		},
		"raw": {
			"type": [
				"object",
				"array",
				"string",
				"number",
				"boolean",
				"null"
			]
		}
	},
	"additionalProperties": true
}
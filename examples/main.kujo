from src.providers import openai_provider
from src.ai_sdk import create_client, create_message, chat_completion

func kv(label, value) {
	print(label + ":", value)
}

func print_lines(lines) {
	for line in lines {
		print(line)
	}
}

func print_summary(mode, result) {
	kv("Mode", mode)
	kv("OK", result["ok"])
	kv("Provider", result["provider"])
	kv("Status", result["status_code"])

	if result["ok"] {
		kv("Model", result["model"])
		kv("Output", result["output_text"])
		kv("Finish reason", result["finish_reason"])
		kv("Usage", result["usage"])
	} else {
		print("Error:", result["error"]["code"], "-", result["error"]["message"])
	}

	print_lines([
		"",
		"Normalized JSON:",
		to_json(result)
	])
}

print_lines([
	"AI SDK Example App",
	"-----------------------"
])

provider := openai_provider()
resolved_api_key := env(provider["api_key_env"])
client := create_client(provider, resolved_api_key)

missing_key := client["api_key"] == ""

messages := [
	create_message("system", "You are a concise assistant for developers."),
	create_message("user", "In one sentence, explain why a standardized AI SDK response format is useful.")
]

if missing_key {
	print_lines([
		"No OPENAI_API_KEY found. Running fixture mode so this project works offline.",
		""
	])
	fixture_result := chat_completion(client, messages, {"offline_fixture": true})
	print_summary("fixture", fixture_result)
} else {
	print_lines([
		"OPENAI_API_KEY detected. Running live OpenAI-compatible request.",
		""
	])
	options := {
		"temperature": 0.2,
		"max_tokens": 140,
		"max_retries": 2,
		"retry_delay_ms": 250
	}
	live_result := chat_completion(client, messages, options)
	print_summary("live", live_result)
}

preference := {
	"class": "frontier_reasoning",
	"preferred": ["team-frontier-model"],
	"fallback": "local-reasoning"
}

print(to_json({
	"openai": resolve_model_preference(openai_provider(), preference),
	"openrouter": resolve_model_preference(openrouter_provider(), preference),
	"deepseek": resolve_model_preference(deepseek_provider(), preference)
}))
